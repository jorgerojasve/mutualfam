# ================================================
# MutualSol - Configuración de Entorno
# Copia este archivo como .env y personaliza los valores
# ================================================

# Aplicación
APP_NAME="MutualSol"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_ALEATORIA

# Base de Datos
DATABASE_URL=postgresql://mutualsol:mutualsol_pass@localhost:5432/mutualsol_db

# JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Tasas de Cambio - Fuentes (se intentan en orden)
BCV_SCRAPE_URL=https://www.bcv.org.ve
DOLAR_API_URL=https://ve.dolarapi.com/v1/dolares
TASA_ACTUALIZACION_MINUTOS=60

# Binance Pay (opcional, para recibir USDT)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# CORS - Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Notificaciones Push (Firebase - opcional para prototipo)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
