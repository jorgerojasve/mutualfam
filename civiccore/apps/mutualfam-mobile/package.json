  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:apk": "npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease --no-daemon && cp app/build/outputs/apk/release/app-release.apk ../mutualfam-qa-v$(node -p \"require('../app.json').expo.version\").apk"
  },
