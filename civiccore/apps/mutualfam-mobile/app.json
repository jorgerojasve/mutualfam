{
  "expo": {
    "name": "Mutual Familiar",
    "slug": "mutualfam-mobile",
    "version": "1.0.0",
    "scheme": "mutualfam",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "sdkVersion": "57.0.0",
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "gradleWrapperVersion": "8.13",
            "kotlinVersion": "2.2.0",
            "newArchEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4dacbcd7-b02a-4f4a-ba89-1800624a2f88"
      }
    },
    "android": {
      "package": "com.jorgerojasve.mutualfammobile"
    }
  }
